# Copy to backend/.env. Existing process variables take precedence.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=papers
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_MODEL=llama-3.3-70b-versatile
# Relative paths are resolved from backend/, not the current working directory.
DATA_DIR=data
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:5173
# Required only when generating answers. Supply your own key; never commit it.
GROQ_API_KEY=
